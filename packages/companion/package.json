{
  "name": "dsh-remote-desktop-companion",
  "version": "0.1.0",
  "description": "Remote companion for dsh-remote-desktop iframe control.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-session-controller": ">=0.1.2-alpha.4 <0.2.0",
    "@deepseek-ai/dsh-api-workspace-controller": ">=0.1.2-alpha.4 <0.2.0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.2-alpha.4 <0.2.0",
    "@deepseek-ai/dsh-workspace": ">=0.1.2-alpha.4 <0.2.0"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "deepseek",
    "cordis",
    "remote-desktop",
    "iframe",
    "companion",
    "remote-workspace"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sincerity711/dsh-remote-desktop.git",
    "directory": "packages/companion"
  },
  "bugs": {
    "url": "https://github.com/sincerity711/dsh-remote-desktop/issues"
  },
  "homepage": "https://github.com/sincerity711/dsh-remote-desktop#readme",
  "publishConfig": {
    "access": "public"
  }
}
