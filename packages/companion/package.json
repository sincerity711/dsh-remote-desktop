{
  "name": "dsh-remote-desktop-companion",
  "version": "0.1.0",
  "description": "Remote companion for dsh-remote-desktop iframe control.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-runtime"],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "files": ["lib", "cordis.patch.yml", "README.md"]
}
