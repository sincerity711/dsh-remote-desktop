{
  "name": "dsh-ssh-workspace-companion",
  "version": "0.2.8",
  "description": "Remote companion for dsh-remote-desktop iframe control.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-session-controller": "0.2.0-rc.2",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2",
    "@deepseek-ai/dsh-workspace": "0.2.0-rc.2"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "deepseek",
    "cordis",
    "remote-desktop",
    "iframe",
    "companion",
    "remote-workspace",
    "ssh-workspace",
    "dsh-ssh-workspace"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sincerity711/dsh-ssh-workspace.git",
    "directory": "packages/companion"
  },
  "bugs": {
    "url": "https://github.com/sincerity711/dsh-ssh-workspace/issues"
  },
  "homepage": "https://github.com/sincerity711/dsh-ssh-workspace#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
