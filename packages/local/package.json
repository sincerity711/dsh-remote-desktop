{
  "name": "dsh-remote-desktop",
  "version": "0.1.0",
  "description": "Connect remote dsh web instances through SSH and browse them from the local dsh sidebar.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.5",
    "react": "^18.2.0"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "deepseek",
    "cordis",
    "remote-desktop",
    "ssh",
    "workspace",
    "remote-workspace",
    "web-ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sincerity711/dsh-remote-desktop.git",
    "directory": "packages/local"
  },
  "bugs": {
    "url": "https://github.com/sincerity711/dsh-remote-desktop/issues"
  },
  "homepage": "https://github.com/sincerity711/dsh-remote-desktop#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "dsh-remote-desktop-companion": "^0.1.0"
  }
}
